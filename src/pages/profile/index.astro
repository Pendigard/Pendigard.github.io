---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SlideIndicator from '../../components/SlideIndicator.astro';
import portrait from '../../assets/images/profile/celian-portrait.jpg';
import { introduction, contacts, skillGroups, languages, hobbies } from '../../sections/profile/content';
import { profileSettings } from '../../sections/profile/settings';
import '../../styles/profile.css';
---
<BaseLayout title="Profile — Célian" description="Célian’s profile, research interests, technical skills, languages and hobbies.">
  <script slot="head" is:inline define:vars={{ introFallbackMs: profileSettings.introFallbackMs }}>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('profile-typing');
      window.setTimeout(() => document.documentElement.classList.remove('profile-typing'), introFallbackMs);
    }
  </script>
  <main class="profile-section" data-profile>
    <section class="profile-slide profile-intro is-active" data-profile-slide aria-label="Profile introduction">
      <div class="profile-slide-inner profile-intro-layout">
        <div class="profile-intro-copy">
          <div class="profile-intro-body">
            <span class="profile-eyebrow" data-typewriter>Profile.</span>
            <h1 data-typewriter data-profile-heading>{introduction.title}</h1>
            {introduction.paragraphs.map((paragraph) => <p data-typewriter>{paragraph}</p>)}
            <div class="profile-research">
              <h2 data-typewriter>Research Interests.</h2>
              <p data-typewriter>{introduction.interests.join(' · ')}</p>
            </div>
          </div>
          <nav class="profile-contacts" aria-label="Contact links">
            {contacts.map((contact) => <a href={contact.href} data-typewriter>{contact.label}</a>)}
          </nav>
        </div>
        <figure class="profile-portrait">
          <Image src={portrait} alt="Célian outdoors, looking to the side." widths={[360, 540, 760]} sizes="(max-width: 680px) 42vw, 30vw" format="webp" quality={80} loading="eager" />
        </figure>
      </div>
    </section>

    <section class="profile-slide profile-skills" data-profile-slide aria-label="Technical Skills">
      <div class="profile-slide-inner">
        <span class="profile-eyebrow" data-typewriter>Profile.</span>
        <h1 data-typewriter data-profile-heading>Technical Skills.</h1>
        <div class="profile-skill-grid">
          {skillGroups.map((group) => <section class="profile-skill-group">
            <h2 data-typewriter>{group.title}.</h2>
            {group.lines.map((line) => <p data-typewriter>{'label' in line ? `${line.label} · ` : ''}{line.items}</p>)}
          </section>)}
        </div>
      </div>
    </section>

    <section class="profile-slide profile-languages" data-profile-slide aria-label="Languages and Communication">
      <div class="profile-slide-inner">
        <span class="profile-eyebrow" data-typewriter>Profile.</span>
        <h1 data-typewriter data-profile-heading>Languages &amp; Communication.</h1>
        <div class="profile-language-grid">
          {languages.map((language) => <article class="profile-language">
            <h2><span data-typewriter>{language.name}</span><span class="profile-language-level" data-typewriter> · {language.level}</span></h2>
            {'translation' in language ? (
              <button type="button" class="profile-language-phrase is-translatable" lang={language.code} data-language-phrase data-original={language.original} data-translation={language.translation} aria-pressed="false" title="Show English translation" data-typewriter>{language.original}</button>
            ) : <p class="profile-language-phrase" lang={language.code} data-typewriter>{language.original}</p>}
          </article>)}
        </div>
      </div>
    </section>

    <section class="profile-slide profile-hobbies" data-profile-slide aria-label="My Hobbies">
      <div class="profile-slide-inner">
        <span class="profile-eyebrow" data-typewriter>Profile.</span>
        <h1 data-typewriter data-profile-heading>My Hobbies.</h1>
        <div class="profile-hobby-grid">
          <section><h2 data-typewriter>What I like.</h2><ul>{hobbies.interests.map((interest) => <li data-typewriter>{interest}</li>)}</ul></section>
          <section><h2 data-typewriter>Sports I practice.</h2><ul>{hobbies.sports.map((sport) => <li data-typewriter>{sport}</li>)}</ul></section>
        </div>
      </div>
    </section>
  </main>
  <SlideIndicator count={4} />
  <script>import '../../scripts/profile';</script>
</BaseLayout>
