---
interface Props { count: number; axis?: 'vertical' | 'horizontal' }
const { count, axis = 'vertical' } = Astro.props;
---
<div
  class="slide-indicator"
  data-slide-indicator
  data-axis={axis}
  role="group"
  aria-label={axis === 'vertical' ? 'Slides' : 'Views'}
  hidden={count < 2}
>
  {Array.from({ length: count }, (_, index) => (
    <button type="button" class="slide-indicator-bar" data-slide-index={index} data-active={String(index === 0)} aria-label={`${axis === 'vertical' ? 'Slide' : 'View'} ${index + 1} of ${count}`} aria-current={index === 0 ? 'step' : undefined}></button>
  ))}
</div>
