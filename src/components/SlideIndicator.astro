---
interface Props { count: number }
const { count } = Astro.props;
---
<div
  class="slide-indicator"
  data-slide-indicator
  data-axis="vertical"
  role="group"
  aria-label="Slides"
  hidden={count < 2}
>
  {Array.from({ length: count }, (_, index) => (
    <button type="button" class="slide-indicator-bar" data-slide-index={index} data-active={String(index === 0)} aria-label={`Slide ${index + 1} of ${count}`} aria-current={index === 0 ? 'step' : undefined}></button>
  ))}
</div>
